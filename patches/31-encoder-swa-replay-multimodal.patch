index 0000000000000000000000000000000000000000..d38777f148dbc8e35c928a4d96b1d38b46b1db35
--- /dev/null
+++ b/test/registered/unit/model_executor/test_encoder_swa_replay_multimodal.py
@@ -0,0 +1,297 @@
+"""Encoder SWA bounded replay must rebuild windows that cover image tokens.
+
+Replay rebuilds a request's sliding window from the last 128 cached-prefix
+token IDs. Image placeholders carry hash-derived pad IDs, so the replay must
+embed the request's own image items for the positions it covers.
+"""
+
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=10, suite="base-a-test-cpu")
+
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+
+from sglang.srt.managers import mm_schedule
+from sglang.srt.managers.io_struct import GenerateReqInput
+from sglang.srt.managers.mm_utils import embed_mm_inputs
+from sglang.srt.managers.schedule_batch import (
+    MM_PAD_SHIFT_VALUE,
+    Modality,
+    MultimodalDataItem,
+    MultimodalInputs,
+    check_encoder_swa_replay_request,
+)
+from sglang.srt.managers.tokenizer_manager import TokenizerManager
+from sglang.srt.mem_cache.multimodal_cache import MultiModalStaticCache
+from sglang.srt.model_executor.encoder_swa_replay import run_encoder_swa_replay
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch, ForwardMode
+from sglang.srt.runtime_context import get_context
+from sglang.test.test_utils import CustomTestCase
+
+WINDOW = 128
+HIDDEN = 8
+VOCAB = 64
+
+
+def _image(first, last, pad_value=MM_PAD_SHIFT_VALUE + 7, modality=Modality.IMAGE):
+    return MultimodalDataItem(
+        modality=modality,
+        hash=pad_value - MM_PAD_SHIFT_VALUE,
+        pad_value=pad_value,
+        offsets=[(first, last)],
+    )
+
+
+def _mm(*items):
+    return MultimodalInputs(mm_items=list(items))
+
+
+def _req(fill_ids, mm_inputs=None):
+    return SimpleNamespace(
+        full_untruncated_fill_ids=list(fill_ids), multimodal_inputs=mm_inputs
+    )
+
+
+class _Window:
+    def __init__(self):
+        self.reset_slots = []
+
+    def reset(self, slot):
+        self.reset_slots.append(int(slot[0]))
+
+
+class TestRunEncoderSwaReplay(CustomTestCase):
+    def _run(self, reqs, prefix_lens, reset):
+        slots = [3, 5, 6][: len(reqs)]
+        window = _Window()
+        forwarded = []
+        runner = SimpleNamespace(
+            device="cpu",
+            token_to_kv_pool=SimpleNamespace(request_window=window),
+            req_to_token_pool=SimpleNamespace(
+                req_to_token=torch.arange(8 * 1024).reshape(8, 1024)
+            ),
+            model=SimpleNamespace(model=SimpleNamespace(engram_hasher=None)),
+            forward=forwarded.append,
+        )
+        batch = SimpleNamespace(
+            forward_mode=ForwardMode.EXTEND,
+            encoder_swa_reset=reset,
+            req_pool_indices=torch.tensor(slots),
+            req_pool_indices_cpu=torch.tensor(slots),
+            prefix_lens=prefix_lens,
+            reqs=reqs,
+            multimodal_inputs=[r.multimodal_inputs for r in reqs],
+        )
+        with patch.object(
+            ForwardBatch,
+            "init_new",
+            side_effect=lambda replay, *args, **kwargs: SimpleNamespace(replay=replay),
+        ):
+            run_encoder_swa_replay(SimpleNamespace(model_runner=runner), batch)
+        return window, [fb.replay for fb in forwarded]
+
+    def test_each_replay_carries_its_request_items(self):
+        inside = _mm(_image(250, 270))
+        before = _mm(_image(10, 40))
+        reqs = [_req(range(400)), _req(range(400), inside), _req(range(400), before)]
+        window, replays = self._run(reqs, [300, 300, 300], [True, True, True])
+        self.assertEqual(window.reset_slots, [3, 5, 6])
+        self.assertEqual(len(replays), 3)
+        for replay, req, slot in zip(replays, reqs, (3, 5, 6)):
+            self.assertEqual(replay.reqs, [req])
+            self.assertEqual(replay.multimodal_inputs, [req.multimodal_inputs])
+            self.assertEqual(replay.prefix_lens, [300 - WINDOW])
+            self.assertEqual(replay.extend_lens, [WINDOW])
+            self.assertEqual(replay.input_ids.tolist(), list(range(300 - WINDOW, 300)))
+            self.assertEqual(
+                replay.out_cache_loc.tolist(),
+                list(range(slot * 1024 + 300 - WINDOW, slot * 1024 + 300)),
+            )
+            self.assertTrue(replay.is_prefill_only)
+
+    def test_requests_without_reset_or_prefix_do_not_replay(self):
+        mm = _mm(_image(0, 3))
+        window, replays = self._run(
+            [_req(range(8), mm), _req(range(8), mm)], [4, 0], [False, True]
+        )
+        self.assertEqual(window.reset_slots, [5])
+        self.assertEqual(replays, [])
+
+
+class _VisionModel:
+    """Returns a full deterministic span per image, like DeepSeek-V4.1."""
+
+    def __init__(self):
+        self.encoded = []
+
+    def get_image_feature(self, items):
+        self.encoded.extend(item.hash for item in items)
+        spans = []
+        for item in items:
+            first, last = item.offsets[0]
+            rows = torch.arange((last - first + 1) * HIDDEN, dtype=torch.float32)
+            spans.append(1000.0 * item.hash + rows.reshape(-1, HIDDEN))
+        return spans
+
+
+class TestReplayImageEmbeddings(CustomTestCase):
+    """The replay range gets the same input rows as the original prefill."""
+
+    def setUp(self):
+        cache = patch.object(
+            mm_schedule, "embedding_cache", MultiModalStaticCache(1 << 30)
+        )
+        cache.start()
+        self.addCleanup(cache.stop)
+        torch.manual_seed(0)
+        self.embedding = torch.nn.Embedding(VOCAB, HIDDEN)
+        self.model = _VisionModel()
+        self.item = _image(10, 25)
+        self.fill_ids = torch.arange(40) % VOCAB
+        self.fill_ids[10:26] = self.item.pad_value
+
+    def _embed(self, mm_inputs, start, end):
+        with torch.no_grad():
+            embeds, _ = embed_mm_inputs(
+                mm_inputs_list=[mm_inputs or MultimodalInputs(mm_items=[])],
+                extend_prefix_lens=[start],
+                extend_seq_lens=[end - start],
+                input_ids=self.fill_ids[start:end].clone(),
+                input_embedding=self.embedding,
+                multimodal_model=self.model,
+            )
+        return embeds
+
+    def test_window_starting_inside_image_matches_full_prefill(self):
+        mm = _mm(self.item)
+        prefill = self._embed(mm, 0, 40)
+        self.assertEqual(self.model.encoded, [self.item.hash])
+
+        replay = self._embed(mm, 20, 32)
+        torch.testing.assert_close(replay, prefill[20:32], rtol=0, atol=0)
+        # The cached embedding serves the replay without another ViT call.
+        self.assertEqual(self.model.encoded, [self.item.hash])
+
+        mm_schedule.embedding_cache.clear()
+        recomputed = self._embed(mm, 20, 32)
+        torch.testing.assert_close(recomputed, prefill[20:32], rtol=0, atol=0)
+        self.assertEqual(self.model.encoded, [self.item.hash] * 2)
+
+    def test_window_after_image_needs_no_vision_work(self):
+        mm = _mm(self.item)
+        prefill = self._embed(mm, 0, 40)
+        mm_schedule.embedding_cache.clear()
+        replay = self._embed(mm, 28, 40)
+        torch.testing.assert_close(replay, prefill[28:40], rtol=0, atol=0)
+        torch.testing.assert_close(
+            replay, self.embedding(self.fill_ids[28:40]), rtol=0, atol=0
+        )
+        self.assertEqual(self.model.encoded, [self.item.hash])
+
+    def test_replay_without_items_gets_no_image_features(self):
+        prefill = self._embed(_mm(self.item), 0, 40)
+        stale = self._embed(None, 20, 32)
+        torch.testing.assert_close(stale[6:], prefill[26:32], rtol=0, atol=0)
+        self.assertFalse(torch.equal(stale[:6], prefill[20:26]))
+
+
+class TestEncoderReplayRequestValidation(CustomTestCase):
+    def setUp(self):
+        override = get_context().override_server_args(
+            enable_encoder_swa_bounded_replay=True
+        )
+        override.install()
+        self.addCleanup(override.restore)
+        self.manager = TokenizerManager.__new__(TokenizerManager)
+        self.manager.context_len = 128
+        self.manager.num_reserved_tokens = 0
+        self.manager.allow_auto_truncate = False
+        self.manager.validate_total_tokens = False
+        self.manager.is_generation = True
+
+    def _validate(self, **kwargs):
+        req = GenerateReqInput(input_ids=[1, 2, 3], sampling_params={}, **kwargs)
+        self.manager._validate_one_request(req, req.input_ids)
+
+    def test_accepts_text_and_image_requests(self):
+        self._validate()
+        self._validate(image_data=["data:image/png;base64,AAAA"])
+        self._validate(return_logprob=True, logprob_start_len=-1)
+
+    def test_rejects_inputs_replay_cannot_rebuild(self):
+        for field, value in (
+            ("video_data", ["video.mp4"]),
+            ("audio_data", ["audio.wav"]),
+            ("input_embeds", [[0.0] * 4]),
+            ("positional_embed_overrides", {"0": [0.0]}),
+        ):
+            with (
+                self.subTest(field),
+                self.assertRaisesRegex(
+                    ValueError, "supports text and image requests only"
+                ),
+            ):
+                self._validate(**{field: value})
+
+    def test_rejects_cached_prompt_logprobs(self):
+        with self.assertRaisesRegex(ValueError, "cached prompt logprobs"):
+            self._validate(return_logprob=True, logprob_start_len=0)
+
+
+class TestSchedulerReplayRequestCheck(CustomTestCase):
+    def _req(self, **overrides):
+        fields = dict(
+            multimodal_inputs=None,
+            input_embeds=None,
+            positional_embed_overrides=None,
+            return_logprob=False,
+            logprob_start_len=-1,
+            origin_input_ids=[1, 2, 3],
+        )
+        fields.update(overrides)
+        return SimpleNamespace(**fields)
+
+    def test_accepts_text_and_image_requests(self):
+        check_encoder_swa_replay_request(self._req())
+        check_encoder_swa_replay_request(
+            self._req(multimodal_inputs=_mm(_image(0, 3), _image(5, 9)))
+        )
+        check_encoder_swa_replay_request(
+            self._req(return_logprob=True, logprob_start_len=3)
+        )
+
+    def test_rejects_other_embedding_sources(self):
+        for name, overrides in (
+            (
+                "video",
+                dict(multimodal_inputs=_mm(_image(0, 3, modality=Modality.VIDEO))),
+            ),
+            (
+                "audio",
+                dict(multimodal_inputs=_mm(_image(0, 3, modality=Modality.AUDIO))),
+            ),
+            ("input embeds", dict(input_embeds=[[0.0]])),
+            ("positional overrides", dict(positional_embed_overrides=object())),
+        ):
+            with (
+                self.subTest(name),
+                self.assertRaisesRegex(
+                    ValueError, "supports text and image requests only"
+                ),
+            ):
+                check_encoder_swa_replay_request(self._req(**overrides))
+
+    def test_rejects_cached_prompt_logprobs(self):
+        with self.assertRaisesRegex(ValueError, "cached prompt logprobs"):
+            check_encoder_swa_replay_request(
+                self._req(return_logprob=True, logprob_start_len=1)
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
