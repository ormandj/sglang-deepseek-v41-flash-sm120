+        speculative_dspark_sps_autotune=mode,
+        speculative_dspark_sps_table_path=explicit,
+    )
+    parallel = SimpleNamespace(
+        tp_group=SimpleNamespace(rank_in_group=0, world_size=1, cpu_group=None),
+        attn_dp_enabled=dp,
+        dp_size=dp_size,
+        pp_size=pp,
+    )
+    exec_ = SimpleNamespace(moe=SimpleNamespace(elastic_ep_backend=elastic))
+    serving = SimpleNamespace(tokenizer_worker_num=tokenizers)
+    return (
+        mock.patch("sglang.srt.runtime_context.get_spec", return_value=spec),
+        mock.patch("sglang.srt.runtime_context.get_parallel", return_value=parallel),
+        mock.patch("sglang.srt.runtime_context.get_exec", return_value=exec_),
+        mock.patch("sglang.srt.runtime_context.get_serving", return_value=serving),
+    )
