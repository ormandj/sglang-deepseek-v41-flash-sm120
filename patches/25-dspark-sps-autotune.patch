+class _CharTokenizer:
+    """Deterministic stand-in: one token per character."""
+
+    def encode(self, text, add_special_tokens=False):
+        return [1000 + (ord(c) % 4000) for c in text]
+
+
+def _uniform(table, bs, ctx):
+    return ContextCost(
+        step_seconds=table.context_step_seconds_at(ctx),
+        token_seconds=torch.full(
+            (bs,), table.context_seconds_per_verify_token(ctx), dtype=torch.float64
+        ),
+    )
+
