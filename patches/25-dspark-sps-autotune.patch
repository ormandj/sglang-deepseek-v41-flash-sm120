+    def test_bonus_only_commits_the_row_zero_bonus(self):
+        # Greedy and sampled (top-p) batches alike: no draft is committed, and the
+        # bonus is the real accept's token at row 0 (the first draft when it was
+        # accepted, else the accept's own resample there), not the token after the
+        # drafts that would have been accepted.
+        for sampling_info in (None, SimpleNamespace(is_all_greedy=False)):
