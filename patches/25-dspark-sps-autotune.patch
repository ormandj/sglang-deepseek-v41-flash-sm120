+        for b in BATCH_SIZES:
+            for m in range(b, b * WIDTH + 1):
+                self.assertAlmostEqual(
+                    table.step_time(num_reqs=b, budget=m - b) * 1e3,
+                    _truth_ms(b, _tier_of(m)),
+                    places=4,
