+def _small_max_blocks_tune_worker(
+    world_size: int, rank: int, port: int, tmpdir: str, max_blocks: int
+) -> None:
+    """A workspace with fewer blocks than the copy-engine depths still tunes."""
+    ws = None
+    group = None
