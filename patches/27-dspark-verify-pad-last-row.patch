diff --git a/test/registered/spec/dspark/test_dspark_compact_top_p.py b/test/registered/spec/dspark/test_dspark_compact_top_p.py
new file mode 100644
index 0000000000000000000000000000000000000000..56dbfa30f2f1e97a6e4887090b3a78003a09fd8c
--- /dev/null
+++ b/test/registered/spec/dspark/test_dspark_compact_top_p.py
@@ -0,0 +1,216 @@
+import unittest
+from types import SimpleNamespace
+from unittest import mock
+
+import torch
+
+from sglang.kernels.ops.speculative.dspark import dspark_accept
+from sglang.srt.speculative.dflash_utils import build_speculative_verify_target_probs
+from sglang.srt.speculative.dspark_components.dspark_draft import DraftBlockResult
+from sglang.srt.speculative.dspark_components.dspark_verify import (
+    accept_draft_tokens,
+)
+from sglang.srt.speculative.ragged_verify import RaggedVerifyLayout
+from sglang.test.ci.ci_register import register_cuda_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cuda_ci(est_time=15, stage="base-b", runner_config="1-gpu-small")
+
+DEVICE = "cuda"
+_VOCAB, _STRIDE = 32000, 6
+_VERIFY_LENS = [6, 3, 1, 4]
+_BS = len(_VERIFY_LENS)
+
+
+def _sampling_info(**overrides):
+    info = SimpleNamespace(
+        temperatures=torch.tensor([[1.0], [0.7], [1.0], [1.3]], device=DEVICE),
+        top_ps=torch.tensor([0.95, 0.9, 0.95, 0.8], device=DEVICE),
+        top_ks=torch.full((_BS,), _VOCAB, dtype=torch.int32, device=DEVICE),
+        need_top_k_sampling=False,
+        need_top_p_sampling=True,
+        is_all_greedy=False,
+        is_any_greedy=False,
+        has_custom_logit_processor=False,
+        acc_linear_penalties=None,
+        penalizer_orchestrator=None,
+        grammar_mask=None,
+        logit_bias=None,
+    )
+    for name, value in overrides.items():
+        setattr(info, name, value)
+    return info
+
+
+def _compact_batch(boost=30.0, data_seed=0):
+    """Strided target logits as the compact verify scatter leaves them: real
+    rows up to each verify length, zero-logit padding after. ``boost`` sets how
+    dominant each row's top token is: 30 makes verified rows effectively
+    one-token distributions; a small boost leaves several tokens inside top-p,
+    so acceptance and rejection both happen before the padding."""
+    gen = torch.Generator(device=DEVICE).manual_seed(data_seed)
+    logits = torch.randn(_BS, _STRIDE, _VOCAB, generator=gen, device=DEVICE)
+    top = torch.randint(0, _VOCAB, (_BS, _STRIDE, 1), generator=gen, device=DEVICE)
+    logits.scatter_add_(2, top, torch.full_like(top, boost, dtype=logits.dtype))
+    real = (
+        torch.arange(_STRIDE, device=DEVICE)[None, :]
+        < torch.tensor(_VERIFY_LENS, device=DEVICE)[:, None]
+    )
+    logits = torch.where(real[..., None], logits, torch.zeros_like(logits))
+    # Drafts: the dominant token on verified rows, random tokens with uniform
+    # draft probs past the window, so every padding check can accept and feeds
+    # the cap-trim counters.
+    target_argmax = top.squeeze(-1)
+    drafts = torch.randint(0, _VOCAB, (_BS, _STRIDE - 1), generator=gen, device=DEVICE)
+    drafts = torch.where(real[:, :-1], target_argmax[:, :-1], drafts)
+    candidates = torch.cat(
+        [torch.zeros(_BS, 1, dtype=torch.long, device=DEVICE), drafts], dim=1
+    )
+    draft_logits = torch.where(
+        real[:, :-1, None],
+        torch.nn.functional.one_hot(drafts, _VOCAB).float() * 20,
+        torch.zeros(_BS, _STRIDE - 1, _VOCAB, device=DEVICE),
+    )
+    draft_block = DraftBlockResult(
+        draft_tokens=drafts,
+        corrected_logits=draft_logits,
+        greedy_mask=torch.zeros(_BS, dtype=torch.bool, device=DEVICE),
+        temperatures=torch.ones(_BS, dtype=torch.float32, device=DEVICE),
+    )
+    layout = RaggedVerifyLayout.from_verify_lens_device(
+        verify_lens=torch.tensor(_VERIFY_LENS, device=DEVICE),
+        graph_num_tokens=sum(_VERIFY_LENS),
+    )
+    return logits.view(_BS * _STRIDE, _VOCAB), candidates, draft_block, layout
+
+
+def _accept(
+    *, compact_padding, sampling_info, seed=1, layout=None, boost=30.0, data_seed=0
+):
+    logits, candidates, draft_block, default_layout = _compact_batch(
+        boost=boost, data_seed=data_seed
+    )
+    layout = default_layout if layout is None else layout
+    torch.manual_seed(seed)
+    return accept_draft_tokens(
+        candidates=candidates,
+        target_logits=logits,
+        draft_block=draft_block,
+        sampling_info=sampling_info,
+        draft_input=SimpleNamespace(max_top_k=None, uniform_top_k_value=None),
+        gamma=_STRIDE - 1,
+        verify_num_draft_tokens=_STRIDE,
+        cutoff_layout=layout,
+        compact_padding=compact_padding,
+    )
+
+
+class TestCompactVerifyTopP(CustomTestCase):
+    def test_target_probs_match_full_renorm(self):
+        logits, _, _, layout = _compact_batch()
+        kwargs = dict(
+            next_token_logits=logits,
+            sampling_info=_sampling_info(),
+            draft_token_num=_STRIDE,
+            bs=_BS,
+        )
+        ref = build_speculative_verify_target_probs(**kwargs)
+        got = build_speculative_verify_target_probs(
+            **kwargs, padding_verify_lens=layout.verify_lens
+        )
+        real = (
+            torch.arange(_STRIDE, device=DEVICE)[None, :]
+            < layout.verify_lens[:, None].long()
+        )
+        # Verified rows run the same renorm; padding rows keep their softmax,
+        # which renorm only rescales by 1 / (sum of the row) ~= 1.
+        torch.testing.assert_close(got[real], ref[real], rtol=0, atol=0)
+        torch.testing.assert_close(got[~real], ref[~real], rtol=1e-6, atol=0)
+
+    def test_accept_and_cap_trim_match_main(self):
+        for seed in range(8):
+            ref = _accept(
+                compact_padding=False, sampling_info=_sampling_info(), seed=seed
+            )
+            got = _accept(
+                compact_padding=True, sampling_info=_sampling_info(), seed=seed
+            )
+            for name, g, r in zip(("correct_len", "bonus", "cap_trim"), got, ref):
+                self.assertTrue(torch.equal(g, r), f"{name} seed={seed}: {g} vs {r}")
+        # The padding checks were exercised: some requests accepted past the window.
+        self.assertGreater(int(ref[2].sum()), 0)
+
+    def test_multi_token_top_p_accepts_and_rejects_like_main(self):
+        # Several tokens survive top-p on every verified row, so draft checks
+        # accept and reject at different depths, including the last row.
+        outcomes = set()
+        for data_seed in range(4):
+            for seed in range(8):
+                kw = dict(
+                    sampling_info=_sampling_info(),
+                    seed=seed,
+                    boost=2.5,
+                    data_seed=data_seed,
+                )
+                ref = _accept(compact_padding=False, **kw)
+                got = _accept(compact_padding=True, **kw)
+                for name, g, r in zip(("correct_len", "bonus", "cap_trim"), got, ref):
+                    self.assertTrue(
+                        torch.equal(g, r),
+                        f"{name} data={data_seed} seed={seed}: {g} vs {r}",
+                    )
+                outcomes.update(
+                    (int(c), int(v)) for c, v in zip(ref[0], _VERIFY_LENS)
+                )
+        # Rejections before the window's end and acceptances up to it occurred.
+        self.assertTrue(any(c < v - 1 for c, v in outcomes))
+        self.assertTrue(any(c >= v - 1 for c, v in outcomes))
+
+    def test_skip_only_when_a_request_has_padding(self):
+        build = dspark_accept.build_speculative_verify_target_probs
+        for verify_lens_cpu, expect_skip in (([6, 3, 1, 4], True), ([6] * _BS, False)):
+            with self.subTest(verify_lens=verify_lens_cpu):
+                layout = RaggedVerifyLayout.from_verify_lens(
+                    verify_lens_cpu=verify_lens_cpu,
+                    device=DEVICE,
+                    grid=[sum(verify_lens_cpu)],
+                )
+                with mock.patch.object(
+                    dspark_accept,
+                    "build_speculative_verify_target_probs",
+                    side_effect=build,
+                ) as spy:
+                    _accept(
+                        compact_padding=True,
+                        sampling_info=_sampling_info(),
+                        layout=layout,
+                    )
+                passed = spy.call_args.kwargs["padding_verify_lens"]
+                self.assertEqual(passed is not None, expect_skip)
+
+    def test_logit_adjustments_keep_full_renorm(self):
+        overrides = (
+            {"logit_bias": torch.zeros(_BS, _VOCAB, device=DEVICE)},
+            {"grammar_mask": object()},
+        )
+        build = dspark_accept.build_speculative_verify_target_probs
+        for override in overrides:
+            with self.subTest(adjustment=next(iter(override))):
+                with mock.patch.object(
+                    dspark_accept,
+                    "build_speculative_verify_target_probs",
+                    side_effect=build,
+                ) as spy:
+                    got = _accept(
+                        compact_padding=True, sampling_info=_sampling_info(**override)
+                    )
+                self.assertIsNone(spy.call_args.kwargs["padding_verify_lens"])
+                ref = _accept(
+                    compact_padding=False, sampling_info=_sampling_info(**override)
+                )
+                for g, r in zip(got, ref):
+                    self.assertTrue(torch.equal(g, r))
+
+
+if __name__ == "__main__":
+    unittest.main()
