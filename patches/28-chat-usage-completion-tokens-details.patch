+/// `chunk` carrying the request's running reasoning-token total.
+pub(super) fn with_reasoning(item: ResponseItem, reasoning_tokens: u64) -> ResponseItem {
+    match item {
+        ResponseItem::Frame(mut output) => {
+            output.reasoning_tokens = reasoning_tokens;
+            ResponseItem::Frame(output)
+        }
+        ResponseItem::Done(mut output) => {
+            output.reasoning_tokens = reasoning_tokens;
+            ResponseItem::Done(output)
+        }
+        other => other,
+    }
+}
