diff --git a/python/sglang/srt/entrypoints/openai/protocol.py b/python/sglang/srt/entrypoints/openai/protocol.py
index 36c1a41f6731019913b87a26f23e43e5aef275fd..ec6f4387dc4dbedaf33f329c1c3d939283ebcad6 100644
--- a/python/sglang/srt/entrypoints/openai/protocol.py
+++ b/python/sglang/srt/entrypoints/openai/protocol.py
@@ -206,14 +206,33 @@ class PromptTokensDetails(BaseModel):
         return data
 
 
+class CompletionTokensDetails(BaseModel):
+    """OpenAI ``usage.completion_tokens_details``."""
+
+    reasoning_tokens: int = 0
+
+
 class UsageInfo(BaseModel):
     prompt_tokens: int = 0
     total_tokens: int = 0
     completion_tokens: Optional[int] = 0
     # Used to return cached tokens info when --enable-cache-report is set
     prompt_tokens_details: Optional[PromptTokensDetails] = None
+    # OpenAI's location for reasoning tokens (0 when the reasoning parser split
+    # none out). The top-level reasoning_tokens is kept for existing clients.
+    completion_tokens_details: Optional[CompletionTokensDetails] = None
     reasoning_tokens: Optional[int] = 0
 
+    @model_serializer(mode="wrap")
+    def _serialize(self, handler):
+        data = handler(self)
+        # Generation endpoints always set completion_tokens_details (through
+        # UsageProcessor); usage built elsewhere (embeddings, score, classify)
+        # omits the key instead of emitting null, which OpenAI does not allow.
+        if data.get("completion_tokens_details") is None:
+            data.pop("completion_tokens_details", None)
+        return data
+
 
 class StreamOptions(BaseModel):
     include_usage: Optional[bool] = False
