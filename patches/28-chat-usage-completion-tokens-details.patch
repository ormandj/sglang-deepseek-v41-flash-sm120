-from sglang.srt.entrypoints.openai.protocol import PromptTokensDetails, UsageInfo
+from sglang.srt.entrypoints.openai.protocol import (
+    CompletionTokensDetails,
+    PromptTokensDetails,
+    UsageInfo,
+)
 
 
 @final
@@ -119,5 +123,10 @@ class UsageProcessor:
             completion_tokens=completion_tokens,
             total_tokens=prompt_tokens + completion_tokens,
             prompt_tokens_details=details,
+            # Also report reasoning tokens where OpenAI clients and gateways look
+            # for them; gateways that pass only standard fields drop the top-level one.
+            completion_tokens_details=CompletionTokensDetails(
+                reasoning_tokens=reasoning_tokens or 0
+            ),
             reasoning_tokens=reasoning_tokens,
         )
