+                    ["model.safetensors"],
+                    framework="pt",
+                    device=torch.device("cuda:1"),
+                    process_group=None,
+                    copy=True,
+                )
+
+    def test_iterator_rejects_non_cuda_devices_before_import(self):
+        for device_type in ("cpu", "xpu", "npu", "musa", "hpu", "mps"):
+            with (
