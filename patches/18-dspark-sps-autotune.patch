+            old.pop(field)
+        loaded = SpsAdditiveCostTable.from_json(json.dumps(old))
+        self.assertTrue(torch.equal(_priced(loaded, [100_000] * 4), _base(original, 4)))
+        with self.assertRaises(ValueError):
