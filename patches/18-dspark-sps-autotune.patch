+        valid[order],
+        token[rows[order]],
+        torch.tensor(context_cost.pad_token_seconds, dtype=torch.float64),
+    )
+    return torch.cat(
+        [torch.zeros(1, dtype=torch.float64), torch.cumsum(per_draft, 0)]
+    ) + float(token.sum())
